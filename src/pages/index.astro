---
const services = [
 {icon:'⌂',title:'Compra e Venda',sub:'de Imóveis',slug:'compra-e-venda'},
 {icon:'⚿',title:'Locação',sub:'de Imóveis',slug:'locacao'},
 {icon:'⚖',title:'Leilões',sub:'Imobiliários',slug:'leiloes'},
 {icon:'▤',title:'Regularização',sub:'de Imóveis',slug:'regularizacao'},
 {icon:'▥',title:'Built to Suit',sub:'',slug:'built-to-suit'},
];
const base = import.meta.env.BASE_URL;
---
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#102438"/><meta name="description" content="Secolo Martins Advocacia. Direito Imobiliário: compra e venda, locação, leilões, regularização de imóveis e Built to Suit. Mauricio Secolo Martins, OAB/SP 293141."/><title>Secolo Martins Advocacia | Direito Imobiliário</title><link rel="icon" href={`${base}assets/logo.svg`} type="image/svg+xml"/></head><body><a class="skip" href="#conteudo">Ir para o conteúdo</a><header class="header"><div class="container nav"><a class="brand" href={base} aria-label="Secolo Martins Advocacia, início"><img src={`${base}assets/logo.svg`} alt="" width="68" height="56"/><span><strong>Secolo Martins</strong><small>ADVOCACIA · DIREITO IMOBILIÁRIO</small></span></a><button class="menu-toggle" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="menu">☰</button><nav id="menu" aria-label="Navegação principal"><a aria-current="page" href={base}>Início</a><a href={`${base}sobre/`}>Sobre</a><a href="#atuacao">Áreas de atuação</a><a href={`${base}artigos/`}>Artigos</a><a href={`${base}contato/`}>Contato</a></nav><a class="whatsapp" href={`${base}contato/`}>Solicitar contato <span aria-hidden="true">↗</span></a></div></header><main id="conteudo"><section class="hero"><div class="container hero-content"><div class="hero-copy"><span class="eyebrow">ADVOCACIA ESPECIALIZADA EM</span><h1>Direito <em>Imobiliário</em></h1><p>Segurança jurídica, regularização e soluções estratégicas para o seu imóvel.</p><div class="actions"><a class="primary" href={`${base}contato/`}>Tire sua dúvida <span aria-hidden="true">→</span></a><a class="secondary" href={`${base}sobre/`}>Conheça o escritório</a></div></div><div class="architecture" role="img" aria-label="Ilustração arquitetônica monocromática de edifício contemporâneo"></div></div></section><section class="areas" id="atuacao"><div class="container"><p class="section-kicker">ATUAÇÃO JURÍDICA</p><h2>Áreas de atuação</h2><p class="section-intro">Assessoria jurídica em diferentes etapas de operações imobiliárias.</p><div class="service-grid">{services.map((service)=><a class="service" href={`${base}areas/${service.slug}/`}><span class="service-icon" aria-hidden="true">{service.icon}</span><span class="service-title">{service.title}<br/>{service.sub}</span><span class="service-arrow" aria-hidden="true">↗</span></a>)}</div></div></section></main><footer><div class="container foot"><div><strong>Secolo Martins Advocacia</strong><span>Direito Imobiliário · Mauricio Secolo Martins · OAB/SP 293141</span></div><a href={`${base}contato/`}>Contato</a><span>© {new Date().getFullYear()} Secolo Martins Advocacia</span></div></footer><script>const btn=document.querySelector('.menu-toggle');const menu=document.querySelector('#menu');btn?.addEventListener('click',()=>{const opened=btn.getAttribute('aria-expanded')==='true';btn.setAttribute('aria-expanded',String(!opened));menu?.classList.toggle('open',!opened)});</script></body></html>
<style is:global>
:root{font-family:Arial,Helvetica,sans-serif;color:#102438;background:#f7f7f5}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0}a{color:inherit;text-decoration:none}a:focus-visible,button:focus-visible{outline:3px solid #c7a46a;outline-offset:4px}.skip{position:absolute;left:-9999px;z-index:5;background:#fff;padding:12px}.skip:focus{left:10px;top:10px}.container{max-width:1250px;margin:auto;padding:0 38px}.header{background:#102438;color:#f7f7f5;border-bottom:1px solid #385066}.nav{display:flex;align-items:center;gap:35px;min-height:112px}.brand{display:flex;align-items:center;gap:12px;min-width:325px}.brand img{width:66px}.brand strong{font:normal 30px Georgia,serif;display:block}.brand small{display:block;letter-spacing:2px;font-size:9px;color:#c7a46a;margin-top:5px}.nav nav{display:flex;gap:25px;align-items:center;margin-left:auto}.nav nav a{font-size:14px;white-space:nowrap;color:#e8e9e8}.nav nav a:hover,.nav nav a[aria-current]{color:#d5b987}.whatsapp{border:1px solid #c7a46a;border-radius:5px;padding:13px 17px;white-space:nowrap;color:#e4c994;font-size:13px}.menu-toggle{display:none}.hero{background:#102438;color:#f7f7f5;overflow:hidden}.hero-content{min-height:485px;display:grid;grid-template-columns:56% 44%;align-items:center;position:relative}.hero-copy{position:relative;z-index:2;padding:65px 0}.eyebrow,.section-kicker{font-size:12px;letter-spacing:4px;color:#c7a46a}.hero h1{font:normal clamp(45px,5.1vw,75px) Georgia,serif;line-height:1.12;margin:25px 0 24px;letter-spacing:-2px}.hero h1 em{font-style:normal;color:#d9b982}.hero p{font-size:21px;line-height:1.55;color:#e2e6e7;max-width:550px}.actions{display:flex;gap:17px;flex-wrap:wrap;margin-top:34px}.actions a{padding:16px 23px;border-radius:5px;font-size:15px}.primary{background:#c7a46a;color:#102438;font-weight:700}.primary span{margin-left:20px}.secondary{border:1px solid #b8c3cb}.architecture{position:absolute;right:-80px;top:0;bottom:0;width:57%;background:linear-gradient(90deg,#102438 0%,rgba(16,36,56,.22) 70%),url('/secolo-martins/assets/arquitetura.svg') center/cover no-repeat;opacity:.75}.areas{padding:76px 0 94px;text-align:center}.section-kicker{color:#98794d}.areas h2{font:normal 47px Georgia,serif;margin:13px 0}.section-intro{color:#626c73;margin:0 auto 40px;line-height:1.6}.service-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:13px}.service{position:relative;min-height:176px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:25px 12px;background:#fff;border:1px solid #e8e7e2;border-radius:5px;transition:transform .2s,border-color .2s}.service:hover{transform:translateY(-3px);border-color:#c7a46a}.service-icon{font-size:34px;color:#b49461;margin-bottom:16px;line-height:1}.service-title{font:normal 19px/1.35 Georgia,serif}.service-arrow{position:absolute;right:13px;bottom:10px;color:#b49461;font-size:16px}footer{background:#0d1f30;color:#d7dde0;padding:30px 0}.foot{display:flex;align-items:center;justify-content:space-between;gap:25px;font-size:12px}.foot strong{font:normal 18px Georgia,serif;display:block;color:white;margin-bottom:5px}.foot span{color:#aab7c0}@media(max-width:1060px){.nav{flex-wrap:wrap;padding-top:15px;padding-bottom:15px;gap:15px}.brand{min-width:0}.nav nav{order:3;width:100%;justify-content:center}.whatsapp{margin-left:auto}.service-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:650px){.container{padding:0 22px}.nav{min-height:82px}.brand img{width:48px;height:45px}.brand strong{font-size:22px}.brand small{font-size:7px;letter-spacing:1px}.menu-toggle{display:block;margin-left:auto;border:1px solid #71808b;background:transparent;color:white;border-radius:4px;padding:8px 12px}.nav nav{display:none;flex-direction:column;align-items:stretch;gap:0}.nav nav.open{display:flex}.nav nav a{padding:12px}.whatsapp{display:none}.hero-content{min-height:530px;display:block}.hero-copy{padding:85px 0}.hero h1{font-size:48px}.hero p{font-size:18px}.architecture{width:100%;right:-28%;opacity:.3}.areas{padding:60px 0}.areas h2{font-size:36px}.service-grid{grid-template-columns:1fr 1fr}.service{min-height:155px}.service-title{font-size:17px}.foot{flex-direction:column;align-items:flex-start}}
</style>
