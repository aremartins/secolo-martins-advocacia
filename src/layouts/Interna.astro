---
import WhatsAppButton from '../components/WhatsAppButton.astro';
const {title, description='Secolo Martins Advocacia — Direito Imobiliário.', active=''} = Astro.props;
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#102B49" />
  <meta name="description" content={description} />
  <title>{title} | Secolo Martins Advocacia</title>
  <link rel="icon" href={`${base}assets/logo.svg`} type="image/svg+xml" />
</head>
<body>
<a class="skip" href="#conteudo">Ir para o conteúdo</a>
<header class="header"><div class="container nav">
<a class="brand" href={base} aria-label="Secolo Martins Advocacia — Início"><img src={`${base}assets/logo.svg`} width="58" height="52" alt="" /><span><strong>Secolo Martins</strong><small>ADVOCACIA · DIREITO IMOBILIÁRIO</small></span></a>
<button class="menu-toggle" type="button" aria-label="Abrir menu" aria-controls="menu" aria-expanded="false">☰</button>
<nav id="menu" aria-label="Navegação principal"><a href={base}>Início</a><a href={`${base}sobre/`} aria-current={active==='sobre'?'page':undefined}>Sobre</a><a href={`${base}#atuacao`} aria-current={active==='areas'?'page':undefined}>Áreas de atuação</a><a href={`${base}artigos/`} aria-current={active==='artigos'?'page':undefined}>Artigos</a><a href={`${base}contato/`} aria-current={active==='contato'?'page':undefined}>Contato</a></nav>
<a class="contact-link" href={`${base}contato/`}>Solicitar contato ↗</a>
</div></header>
<main id="conteudo"><slot /></main>
<footer><div class="container foot"><div><strong>Secolo Martins Advocacia</strong><span>Direito Imobiliário · Mauricio Secolo Martins · OAB/SP 293141</span></div><div class="foot-links"><a href={`${base}contato/`}>Contato</a><a href={`${base}privacidade/`}>Privacidade</a></div><span>© {year} Secolo Martins Advocacia</span></div></footer>
<script>const btn=document.querySelector('.menu-toggle');const menu=document.querySelector('#menu');btn?.addEventListener('click',()=>{const opened=btn.getAttribute('aria-expanded')==='true';btn.setAttribute('aria-expanded',String(!opened));menu?.classList.toggle('open',!opened)});</script>
<WhatsAppButton /></body></html>
<style is:global>
:root{font-family:Arial,Helvetica,sans-serif;color:#102B49;background:#F7F6F3}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0}a{color:inherit;text-decoration:none}a:focus-visible,button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:3px solid #B69A60;outline-offset:3px}.skip{position:absolute;left:-9999px;z-index:10;background:white;padding:12px}.skip:focus{left:10px;top:10px}.container{max-width:1200px;margin:auto;padding:0 34px}.header{background:#102B49;color:#F7F6F3;border-bottom:1px solid #385066}.nav{min-height:100px;display:flex;align-items:center;gap:25px}.brand{display:flex;align-items:center;gap:12px;min-width:285px}.brand img{width:58px}.brand strong{display:block;font:normal 27px Georgia,serif}.brand small{display:block;color:#B69A60;font-size:9px;letter-spacing:1.4px;margin-top:5px}.nav nav{display:flex;gap:20px;align-items:center;margin-left:auto}.nav nav a{font-size:13px;white-space:nowrap;color:#e8e9e8}.nav nav a:hover,.nav nav a[aria-current]{color:#D7BF90}.contact-link{border:1px solid #B69A60;border-radius:5px;padding:12px;color:#E3CDA3;font-size:13px;white-space:nowrap}.menu-toggle{display:none}.page-heading{background:#102B49;color:#F7F6F3;padding:70px 0 76px}.eyebrow{color:#B69A60;letter-spacing:3px;text-transform:uppercase;font-size:12px}.page-heading h1{font:normal clamp(36px,5vw,58px) Georgia,serif;line-height:1.15;margin:15px 0}.page-heading p{color:#d5dde3;font-size:18px;line-height:1.6;max-width:690px}.content{padding:64px 0 90px}.content h2{font:normal 32px Georgia,serif;color:#102B49;margin:36px 0 15px}.content h3{font:normal 23px Georgia,serif;color:#102B49}.content p,.content li{font-size:16px;line-height:1.8;color:#40515e}.content ul{padding-left:22px}.content a:not(.button){text-decoration:underline;text-underline-offset:3px}.narrow{max-width:850px}.button{display:inline-block;background:#B69A60;color:#102B49;font-weight:700;padding:15px 24px;border-radius:5px;margin-top:20px}.button:hover{background:#C8AD7A}.muted{color:#596675}.notice{background:#eef0ef;border-left:3px solid #B69A60;padding:18px 22px;margin:25px 0}.cards{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}.card{border:1px solid #e2e4e4;border-radius:6px;background:white;padding:24px}.card h2{margin-top:0;font-size:25px}.card a{color:#102B49}.profile{display:grid;grid-template-columns:190px 1fr;gap:42px;align-items:start}.profile img{width:190px;height:220px;object-fit:cover;object-position:center top;border-radius:5px;filter:saturate(.65)}footer{background:#102238;color:#d7dde0;padding:28px 0}.foot{display:flex;align-items:center;justify-content:space-between;gap:20px;font-size:12px}.foot strong{font:normal 18px Georgia,serif;display:block;color:#fff;margin-bottom:5px}.foot span{color:#aab7c0}.foot-links{display:flex;gap:20px}.foot a:hover{text-decoration:underline}@media(max-width:1050px){.nav{flex-wrap:wrap;padding-top:15px;padding-bottom:15px}.brand{min-width:0}.nav nav{order:3;width:100%;justify-content:center}.contact-link{margin-left:auto}}@media(max-width:650px){.container{padding:0 22px}.nav{min-height:78px}.brand img{width:46px;height:44px}.brand strong{font-size:22px}.brand small{font-size:7px}.menu-toggle{display:block;margin-left:auto;border:1px solid #71808b;background:transparent;color:#fff;padding:8px 12px;border-radius:4px}.nav nav{display:none;flex-direction:column;align-items:stretch;gap:0}.nav nav.open{display:flex}.nav nav a{padding:12px}.contact-link{display:none}.page-heading{padding:50px 0}.content{padding:40px 0 60px}.cards,.profile{grid-template-columns:1fr}.profile img{width:145px;height:175px}.foot{flex-direction:column;align-items:flex-start}}

/* Brand system: high-contrast light header and contemporary wordmark. */
.header{background:#F7F6F3;color:#102B49;border-bottom:1px solid #e4dfd5}
.brand strong{font-family:Arial,Helvetica,sans-serif;font-weight:700;letter-spacing:-.6px;color:#102B49}
.brand small{color:#494B50}
.nav nav a{color:#102B49}
.nav nav a:hover,.nav nav a[aria-current]{color:#907448}
.contact-link{color:#102B49;border-color:#B69A60}
.menu-toggle{color:#102B49;border-color:#B69A60}
.brand img{display:block;object-fit:contain}
@media(max-width:900px){.nav{gap:12px}.brand{min-width:0}.brand span{min-width:0}.brand strong{font-size:clamp(18px,3vw,26px)}}
@media(max-width:650px){.brand{flex:1;min-width:0}.brand img{width:48px;height:48px;flex-shrink:0}.brand strong{font-size:clamp(18px,5vw,22px)}.brand small{font-size:7px;letter-spacing:.7px}.menu-toggle{color:#102B49;border-color:#B69A60}}
</style>
